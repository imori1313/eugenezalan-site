---
import '../styles/global.css';
import '../styles/pages.css';
import '../styles/motion.css';
import '../styles/hero-gallery.css';
import '../styles/about-scroll.css';
import '../styles/floating-contact.css';
import Arrow from '../components/Arrow.astro';
import {contact} from '../data/projects';
const { title='Eugene Zalan — Sculptural furniture, made to commission', description='Discover sculptural sideboards and collectible furniture by Eugene Zalan. Explore the collection and discuss a bespoke furniture commission in London.', pageClass='' }=Astro.props;
const path=Astro.url.pathname.replace(/\/$/,'')||'/';
const navigation=[['Home','/'],['About','/about'],['Collection','/projects'],['Contact','/contact']];
const canonical=new URL(path,'https://eugenezalan.com');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title><meta name="description" content={description}/>
    <meta name="theme-color" content="#111210"/><link rel="canonical" href={canonical}/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/>
    <meta property="og:image" content="https://eugenezalan.com/media/hero-poster.jpg"/><meta name="twitter:card" content="summary_large_image"/>
    <link rel="icon" type="image/webp" href="/media/about/emblem-640.webp"/>
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin/>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Eugene Zalan home">Eugene Zalan</a>
      <nav class="desktop-nav" aria-label="Main navigation">{navigation.map(([name,href])=><a href={href} class:list={['nav-link',{'is-active':href==='/'?path==='/':path.startsWith(href)}]} aria-current={(href==='/'?path==='/':path.startsWith(href))?'page':undefined}><span data-roll>{name}</span></a>)}</nav>
      <div class="header-location">London UK<span>Furniture Designer + Maker</span></div>
      <button class="menu-toggle" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false"><span></span><span></span></button>
    </header>
    <dialog id="mobile-menu" class="mobile-menu">
      <div class="menu-top"><a class="wordmark" href="/">Eugene Zalan</a><button class="menu-close" aria-label="Close menu">Close <span aria-hidden="true">×</span></button></div>
      <nav aria-label="Mobile navigation">{navigation.map(([name,href],i)=><a href={href}>{name}<span>0{i+1}</span></a>)}<a href="/commission">Commissions <span>05</span></a></nav>
      <div class="menu-contact"><span>Let’s make something personal.</span><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
    </dialog>
    <main id="main"><slot/></main>
    <footer class="site-footer">
      <div class="footer-top"><a class="footer-name" data-name-sparks href="/">Eugene Zalan</a><p>Sculptural furniture.<br/>A personal point of view.</p></div>
      <div class="footer-links"><a href={`mailto:${contact.email}`}>{contact.email}</a><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a><a href="https://www.instagram.com/eugene_zalan/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Eugene Zalan · London</span><nav aria-label="Footer navigation"><a href="/projects">Collection</a><a href="/contact">Contact</a><a href="/privacy">Privacy</a></nav></div>
    </footer>
    <a class="whatsapp" href={contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Discuss a bespoke furniture commission with Eugene on WhatsApp">
      <span class="whatsapp-label">WHATSAPP</span>
      <svg width="25" height="25" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.4-5A8.4 8.4 0 1 1 20.5 11.7Z" stroke="currentColor" stroke-width="1.5"/><path d="M8 7.5c.3-.3.6-.3.8.1l1 2c.1.3 0 .5-.4 1-.2.2-.2.3 0 .6.8 1.4 1.8 2.3 3.2 2.8.3.1.4.1.6-.1l.9-1c.2-.2.4-.2.6-.1l2 1c.3.2.3.4.2.7-.3 1-1 1.7-2.1 1.7-2.5 0-6.2-2.6-7.3-5.2-.6-1.5-.4-2.6.5-3.5Z" fill="currentColor"/></svg>
    </a>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
