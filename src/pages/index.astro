---
import Layout from '../layouts/Layout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import MotionText from '../components/MotionText.astro';
import {projects} from '../data/projects';
const featured=[projects[6],projects[0],projects[2]];
const commissionRows=[
 {title:'Sculptural Sideboards',text:'An original focal point for your room. Explore the collection and discuss a piece for your space.',image:projects[1].cover,href:'/projects'},
 {title:'Cabinetry & Wardrobes',text:'Storage considered around the way you live — from a private bar to a personal collection.',image:'/images/details/commission-cabinetry.png',href:'/commission'},
 {title:'Signature Surfaces & Details',text:'Carved relief, original patterns and jewellery-like details that carry the idea into the everyday.',image:'/images/projects/sherwood/handle-detail.jpg',href:'/projects/sherwood'},
 {title:'Private Commissions',text:'Bring a space, a favourite piece or the beginning of an idea. Let’s discuss what it could become.',image:'/images/details/commission-private.png',href:'/contact'},
];
const aboutText='Eugene Zalan — furniture artist & maker. Creating bespoke sculptural furniture with an eye for the unexpected, a feeling for materials and experience since 2004.';
const stages=[
 {title:'01 — Ideas & Conversation',text:'Start with a piece you are drawn to, or an idea of your own. Tell me about the room, the purpose of the furniture and the details that matter to you.',image:'/images/details/inspiration-lamp.png',alt:'An imaginative miniature forest inside a light bulb'},
 {title:'02 — Concept & Development',text:'We explore form, proportions, materials and internal layout. The direction and scope become clear before the commission is agreed.',image:'/images/details/concept-relief.png',alt:'Furniture concept with sculptural circular relief'},
 {title:'03 — Making & Detail',text:'Design, specification, quotation and arrangements are agreed before making begins. Each element is considered as part of the finished object.',image:'/images/details/cnc-making.png',alt:'A machining tool shaping a wooden surface'},
 {title:'04 — Delivery & Life',text:'Delivery and any installation requirements are discussed for your location. The finished piece becomes part of the way you live.',image:'/images/details/concept-sideboard.png',alt:'A sideboard concept with a sculptural facade'},
];
const strip=[projects[4],projects[6],projects[2],projects[3],projects[5]];
---
<Layout title="Bespoke furniture in London — Eugene Zalan" description="Original sculptural sideboards, cabinets and collectible furniture by Eugene Zalan. Explore the pieces and discuss a bespoke commission with the designer and maker in London." pageClass="home faithful-home">
  <section class="faithful-hero shell" aria-label="Eugene Zalan furniture">
    <div class="hero-split"><div class="hero-positioning"><MotionText as="h1" text="Bespoke furniture in London." immediate/><MotionText as="p" text="Sculptural sideboards & collectible objects." immediate/><div class="hero-actions"><a class="pill-link" href="/projects"><span data-roll>View collection</span><Arrow/></a><a class="text-link hero-enquiry" href="/contact">Discuss a commission <Arrow/></a></div></div><HeroVideo/></div>
    <div class="brand-ribbon" aria-hidden="true"><div>{[0,1].map(()=> <span>Collectible furniture <b>✳</b> Sculptural forms <b>✳</b> Designed in London <b>✳</b> Original pieces <b>✳</b></span>)}</div></div>
    <div class="name-stage" aria-label="Eugene Zalan"><div class="flying-name" data-name-sparks aria-hidden="true">Eugene Zalan</div></div>
  </section>
  <section class="faithful-intro shell" id="selected"><div class="intro-statement"><MotionText as="h2" text="Original furniture, designed to commission. A sculptural presence. A practical place in your life."/><div class="intro-actions"><a class="pill-link" href="/projects"><span data-roll>View full collection</span><Arrow/></a><a class="text-link" href="/contact">Discuss a commission <Arrow/></a></div></div><div class="feature-viewer" data-feature-viewer><div class="feature-slides">{featured.map((p,i)=><a href={`/projects/${p.slug}`} class:list={['feature-slide',{'is-selected':i===0}]} data-feature-slide aria-hidden={i!==0?'true':undefined} tabindex={i===0?0:-1}><Photo src={p.cover} alt={p.gallery[0].alt} sizes="(min-width: 810px) 65vw, 100vw"/><span class="feature-label"><span>{p.name} <small>{p.kind}</small></span><span class="feature-project-action">View project <Arrow/></span></span></a>)}</div><div class="feature-selector" aria-label="Selected pieces">{featured.map((p,i)=><button aria-label={`Show ${p.name}`} aria-pressed={i===0?'true':'false'} data-feature-button={i}>0{i+1}</button>)}</div></div></section>
  <section class="faithful-commissions shell" id="commissions"><MotionText as="h2" class="giant-heading" text="Commissions"/><div class="commissions-layout"><p class="commission-side-note">A piece from the collection.<br/>An idea of your own.<br/><a href="/commission" class="text-link">Explore the process <Arrow/></a></p><div class="commission-rows" data-commission-rows>{commissionRows.map((r,i)=><article class="commission-row" data-commission-row><button class="commission-row-trigger" aria-expanded="false" aria-controls={`commission-preview-${i}`}><span class="row-number">0{i+1}</span><span class="row-title" data-roll>{r.title}</span><span class="row-description">{r.text}</span><span class="row-plus" aria-hidden="true">+</span></button><div class="touch-row-detail" id={`commission-preview-${i}`}><Photo src={r.image} alt={`${r.title} — Eugene Zalan furniture`} sizes="200px"/><a class="text-link" href={r.href}>{i===0?'View collection':i===3?'Discuss your idea':'Explore'} <Arrow/></a></div><a class="row-desktop-link" href={r.href} aria-label={`Explore ${r.title}`}><Arrow/></a><div class="hover-preview" aria-hidden="true"><Photo src={r.image} alt={`${r.title} preview`} sizes="220px"/></div></article>)}</div></div></section>
  <section class="scroll-about" data-scroll-about><div class="scroll-about-stage"><div class="scroll-about-portrait"><Photo src="/images/about/portrait.png" alt="Eugene Zalan" sizes="(min-width: 901px) 44vw, (min-width: 601px) 60vw, 78vw"/></div><div class="scroll-about-words"><p aria-label={aboutText}>{aboutText.split(' ').map((word:string,i:number)=><span class="scroll-word" data-name-sparks={i<2?true:undefined} aria-hidden="true">{word} </span>)}</p><a class="pill-link" href="/about"><span data-roll>About Eugene</span><Arrow/></a></div></div></section>
  <section class="faithful-process shell" id="process"><div class="process-marquee" aria-label="Process"><div aria-hidden="true"><span>PROCESS©</span><span>PROCESS©</span><span>PROCESS©</span></div></div><a class="pill-link process-contact" href="/contact"><span data-roll>Get in touch</span><Arrow/></a><div class="original-process-grid">{stages.map((s,i)=><article class={`original-stage stage-${i}`}><MotionText as="p" text={s.text}/><div class="process-image" data-image-reveal><Photo src={s.image} alt={s.alt} sizes="(min-width: 810px) 42vw, 100vw"/></div><h3>{s.title}</h3></article>)}</div></section>
  <section class="home-enquiry shell"><MotionText as="h2" text="A space. An idea. A conversation."/><a class="pill-link" href="/contact"><span data-roll>Discuss your commission</span><Arrow/></a></section>
  <section class="moving-collection" aria-label="Explore the furniture collection"><div class="strip-heading shell"><a class="text-link" href="/projects">Explore the Collection <Arrow/></a><button class="strip-toggle" type="button" aria-label="Pause moving collection">Pause Ⅱ</button></div><div class="strip-window" tabindex="0" aria-label="Moving furniture images; focus to pause"><div class="moving-strip">{[0,1].map(copy=><div class="strip-group" aria-hidden={copy===1?'true':undefined}>{strip.map((p,i)=><a href={`/projects/${p.slug}`} class={`strip-item strip-${i}`} tabindex={copy===1?-1:0}><Photo src={p.cover} alt={p.gallery[0].alt} sizes="(min-width: 810px) 35vw, 75vw"/><span>{p.name}<Arrow/></span></a>)}</div>)}</div></div></section>
</Layout>
