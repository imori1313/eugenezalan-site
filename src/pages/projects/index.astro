---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import EnquiryBanner from '../../components/EnquiryBanner.astro';
import {projects, formatPrice} from '../../data/projects';
---
<Layout title="Collection — Sculptural sideboards & cabinets | Eugene Zalan" description="Explore seven sculptural sideboards and cabinets by London furniture maker Eugene Zalan. Choose a collection piece or commission an original design." pageClass="collection-page">
  <section class="collection-intro shell"><div class="page-kicker"><span class="eyebrow">SIDEBOARDS & CABINETS</span><span class="eyebrow">01—07</span></div><h1>The <em>collection</em></h1><div class="collection-intro-bottom"><span class="collection-line" aria-hidden="true"></span><p>Choose from seven sideboard and cabinet designs, or commission a completely new piece in Eugene’s sculptural style, designed and made around your requirements.</p><a class="text-link" href="/commission">Commission a new design</a></div></section>
  <section class="collection-list shell" aria-label="Furniture collection">{projects.map((p,i)=><article class:list={['collection-piece',`collection-piece-${i+1}`]} style={`--piece-accent:${p.accent}`} data-reveal><div class="collection-meta"><span class="piece-index">0{i+1}</span><span class="eyebrow">{p.kind}</span></div><a class="collection-image project-image" href={`/projects/${p.slug}`} aria-label={`Explore ${p.name}`}><Photo src={p.cover} alt={p.gallery[0].alt} eager={i===0} sizes={i===0?'100vw':'(min-width: 900px) 70vw, 100vw'}/><span class="image-action">Discover {p.name}</span></a><div class="collection-caption"><h2><a href={`/projects/${p.slug}`}>{p.name}</a></h2><div><p>{p.concept}</p><span class="collection-status">{p.price ? formatPrice(p.price) : 'Price on request'}</span></div></div></article>)}</section>
  <EnquiryBanner title="Interested in a piece?"/>
</Layout>
