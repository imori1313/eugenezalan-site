---
import Layout from '../layouts/Layout.astro';
import {contact} from '../data/projects';
import Photo from '../components/Photo.astro';
import MotionText from '../components/MotionText.astro';
---
<Layout title="Discuss a furniture commission — Contact Eugene Zalan" description="Talk to Eugene Zalan about a bespoke furniture commission. Share your ideas, the piece you are considering and the space you have in mind." pageClass="contact-page">
  <section class="contact-visual"><Photo src="/images/projects/la-clavelina/handle-closeup.jpeg" alt="Golden flower-shaped furniture handle by Eugene Zalan" eager sizes="100vw"/><MotionText as="h1" text="Get in touch" direction="down" immediate/></section>
  <section class="contact-section shell"><div class="contact-aside"><h2>Tell me what<br/>you have in mind</h2><p>A particular piece, a room, or the beginning of an idea. You don’t need to have every detail worked out.</p><div class="contact-direct"><span class="eyebrow">DIRECTLY TO EUGENE</span><a href={`mailto:${contact.email}`}>{contact.email}</a><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a><a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" class="whatsapp-inline">Start a conversation on WhatsApp</a><span class="location-note">Based in London, United Kingdom</span></div></div>
    
  </section>
</Layout>

<style>.contact-section{grid-template-columns:1fr}.contact-aside{max-width:760px}</style>
