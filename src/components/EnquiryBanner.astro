---
import {enquiryLinks} from '../data/enquiries';
const { title='Something in mind?', piece='' }=Astro.props;
---
<section class="enquiry-banner shell" data-reveal><span class="eyebrow">ENQUIRIES & COMMISSIONS</span><h2>{title}</h2><a class="button" href={`/contact${piece?`?piece=${encodeURIComponent(piece)}`:''}`}>{piece?`Ask Eugene about ${piece}`:'Discuss a commission'}</a><a class="quiet-link" href={enquiryLinks(piece).email} data-enquiry-email>Or email me directly</a></section>
