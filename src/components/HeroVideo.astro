---
const { compact = false } = Astro.props;
---
<div class:list={['film', {compact}]} data-film>
  <video data-responsive-video data-credit-start="30.8" data-mobile-credit-start="33.3" data-desktop="/videos/hero-desktop.mp4" data-mobile="/videos/hero-mobile.mp4" data-desktop-poster="/media/hero-poster.webp" data-mobile-poster="/media/hero-mobile-poster.webp" poster="/media/hero-poster.webp" autoplay muted loop playsinline preload="auto" aria-label="Eugene Zalan furniture film"></video>
  <noscript><video poster="/media/hero-mobile-poster.webp" autoplay muted loop playsinline controls aria-label="Eugene Zalan furniture film"><source src="/videos/hero-mobile.mp4" media="(max-width: 767px)" type="video/mp4" /><source src="/videos/hero-desktop.mp4" type="video/mp4" /></video></noscript>
  <div class="film-caption"><a class="film-credit" href="https://imorifilms.com" aria-label="Film by Imori Films">Film by Imori Films</a><div class="film-controls"><div class="film-sound-group"><button class="film-control film-sound" type="button" aria-label="Turn sound on" aria-pressed="false" data-sound-toggle><svg viewBox="0 0 24 24" width="19" height="19" fill="none" aria-hidden="true"><path d="M11 4 5 9H2v6h3l6 5V4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path class="mute-slash" d="m3 3 18 18" stroke="currentColor" stroke-width="1.7"/></svg><span data-sound-label>Sound off</span></button><div class="volume-panel"><label for="hero-volume">Volume <output data-volume-value for="hero-volume">0%</output></label><input id="hero-volume" data-volume-slider type="range" min="0" max="100" step="1" value="0" aria-label="Video volume" /></div></div><button class="film-control" type="button" aria-label="Pause film" data-video-toggle><span data-video-label>Pause</span><span data-video-icon aria-hidden="true">Ⅱ</span></button></div></div>
</div>






