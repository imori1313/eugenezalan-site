---
import Photo from './Photo.astro';
const {items,name}=Astro.props;
const large=(src:string)=>`/media/${src.replace(/^\/images\//,'').replace(/\.[^.]+$/,'')}-2000.webp`;
---
<section class="gallery-section shell" data-gallery>
  <div class="gallery-top"><span class="eyebrow">A CLOSER LOOK</span><span class="gallery-instruction"><span class="gallery-browse-hint"><svg viewBox="0 0 60 18" width="60" height="18" fill="none" aria-hidden="true"><path d="M1 9h58M8 2 1 9l7 7M52 2l7 7-7 7" stroke="currentColor" stroke-width="1.2"/></svg><span class="desktop-gallery-hint">Explore left & right</span><span class="touch-gallery-hint">Swipe to explore</span></span><span>Select a photograph to view full screen</span></span></div>
  <div class="gallery-viewer">
  <div class="gallery-track" aria-label={`${name} image gallery`} tabindex="0">{items.map((item:{src:string;alt:string},i:number)=><button type="button" class="gallery-item" data-gallery-index={i} data-gallery-src={large(item.src)} data-gallery-alt={item.alt} aria-label={`Open image ${i+1}: ${item.alt}`}><Photo src={item.src} alt={item.alt} sizes="(min-width: 900px) 58vw, 90vw"/><span class="gallery-expand" aria-hidden="true">+</span></button>)}</div>
  <button class="gallery-edge gallery-prev" type="button" aria-label="Scroll photographs left"><svg viewBox="0 0 32 20" width="32" height="20" fill="none" aria-hidden="true"><path d="M30 10H2m8-8-8 8 8 8" stroke="currentColor" stroke-width="1.3"/></svg></button><button class="gallery-edge gallery-next" type="button" aria-label="Scroll photographs right"><svg viewBox="0 0 32 20" width="32" height="20" fill="none" aria-hidden="true"><path d="M2 10h28m-8-8 8 8-8 8" stroke="currentColor" stroke-width="1.3"/></svg></button>
  </div>
  <div class="gallery-toolbar"><span><span data-gallery-counter>01</span> / {String(items.length).padStart(2,'0')}</span><div><button class="gallery-prev" aria-label="Previous gallery image">←</button><button class="gallery-next" aria-label="Next gallery image">→</button></div></div>
  <dialog class="gallery-dialog" aria-label={`${name} full-screen gallery`}>
    <div class="lightbox-toolbar"><span>{name}</span><span data-lightbox-count></span><button type="button" class="lightbox-close" aria-label="Close full-screen gallery">Close ×</button></div>
    <div class="lightbox-stage"><button class="lightbox-prev" aria-label="Previous image">←</button><div class="lightbox-viewport"><img data-lightbox-image alt=""/><p data-lightbox-error hidden>Unable to load this image. Please try another image.</p></div><button class="lightbox-next" aria-label="Next image">→</button></div>
    <div class="lightbox-bottom"><p data-lightbox-caption></p><button class="lightbox-zoom" aria-pressed="false">Zoom in +</button></div>
  </dialog>
</section>
